        "prettier": "^3.2.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "turbo": "^1.12.0",
        "vitest": "^4.0.18",
        "prisma": "5.22.0"
    },
    "packageManager": "pnpm@8.15.0"
}