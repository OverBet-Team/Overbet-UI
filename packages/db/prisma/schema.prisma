generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String       @id @default(uuid())
  username  String
  isGuest   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  rooms               Room[]
  members             RoomMember[]
  ledgerEntries       LedgerEntry[]       @relation("UserLedgerEntries")
  ledgerConfirmations LedgerConfirmation[] @relation("UserLedgerConfirmations")
}

model RoomMember {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  seatIndex Int?
  stack     Int      @default(0)
  status    String   @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
}

model Room {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    String       @default("LOBBY") // LOBBY | IN_PROGRESS | FINISHED | SETTLED
  hostId    String
  host      User         @relation(fields: [hostId], references: [id])
  settings  Json?        // Variant & modding configuration
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  hands     Hand[]
  members             RoomMember[]
  ledgerEntries       LedgerEntry[]       @relation("RoomLedgerEntries")
  ledgerConfirmations LedgerConfirmation[] @relation("RoomLedgerConfirmations")
}

model Hand {
  id        String      @id @default(uuid())
  roomId    String
  room      Room        @relation(fields: [roomId], references: [id])
  metadata  Json? // Plugin modifiers & pot sizes
  createdAt DateTime    @default(now())
  events    HandEvent[]
}

model HandEvent {
  id        String   @id @default(uuid())
  handId    String
  hand      Hand     @relation(fields: [handId], references: [id])
  type      String
  sequence  Int
  payload   Json
  createdAt DateTime @default(now())

  @@unique([handId, sequence])
}


model LedgerEntry {
  id        String          @id @default(uuid())
  roomId    String
  room      Room            @relation("RoomLedgerEntries", fields: [roomId], references: [id])
  userId    String
  user      User            @relation("UserLedgerEntries", fields: [userId], references: [id])
  type      String          // BUY_IN | ADD_ON | CASH_OUT | ADJUSTMENT | VOID
  amount    Int             // always positive; type determines direction semantics
  authorId  String          // who recorded this (player self-report or host); raw FK, no Prisma relation to avoid triple-relation
  parentId  String?         // for ADJUSTMENT/VOID: references the entry being corrected
  note      String?         // required for ADJUSTMENT/VOID; optional otherwise
  createdAt DateTime        @default(now())

  disputes  LedgerDispute[]

  @@index([roomId])  // primary query pattern: fetch all entries for a room
}
model LedgerDispute {
  id               String       @id @default(uuid())
  ledgerEntryId    String
  ledgerEntry      LedgerEntry  @relation(fields: [ledgerEntryId], references: [id])
  raisedByUserId   String
  note             String
  status           String       @default("OPEN") // OPEN | ACKNOWLEDGED | OVERRIDDEN | DISMISSED
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([ledgerEntryId])  // join pattern: disputes for a specific entry
}

model LedgerConfirmation {
  id          String   @id @default(uuid())
  roomId      String
  room        Room     @relation("RoomLedgerConfirmations", fields: [roomId], references: [id])
  userId      String
  user        User     @relation("UserLedgerConfirmations", fields: [userId], references: [id])
  confirmedAt DateTime @default(now())

  @@unique([roomId, userId])
}